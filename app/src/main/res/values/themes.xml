<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.NewCarplay" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
        <item name="android:fitsSystemWindows">true</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:statusBarColor">@color/cp_bg_top</item>
        <item name="android:navigationBarColor">@color/cp_bg_bottom</item>
        <item name="colorPrimary">@color/cp_accent_blue</item>
        <item name="colorAccent">@color/cp_accent</item>
        <item name="colorSecondary">@color/cp_accent</item>
        <!-- App-wide product typeface -->
        <item name="android:fontFamily">@font/manrope</item>
        <item name="fontFamily">@font/manrope</item>
    </style>

    <style name="Theme.NewCarplay" parent="Base.Theme.NewCarplay" />

    <style name="AppTheme.Ads" parent="Theme.MaterialComponents.Light">
        <item name="android:textSize">@dimen/_10sdp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:layout_gravity">left</item>
        <item name="android:background">@drawable/ads_icon</item>
        <item name="android:layout_marginLeft">@dimen/_1sdp</item>
        <item name="android:layout_marginTop">@dimen/_1sdp</item>
        <item name="android:paddingLeft">@dimen/_5sdp</item>
        <item name="android:paddingRight">@dimen/_5sdp</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">@dimen/_15sdp</item>
        <item name="android:minHeight">@dimen/_15sdp</item>
        <item name="android:text">AD</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="RatingBar" parent="Theme.AppCompat">
        <item name="colorControlNormal">@color/white</item>
        <item name="colorControlActivated">@color/orange</item>
    </style>
    <style name="AdActivityTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowIsTranslucent">false</item>
    </style>
</resources>