<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.NewCarplay" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
        <item name="android:fitsSystemWindows">true</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="alertDialogTheme">@style/DarkAlertDialog</item>
        <item name="android:alertDialogTheme">@style/DarkAlertDialog</item>
        <item name="android:datePickerDialogTheme">@style/DarkDatePicker</item>
        <item name="android:timePickerDialogTheme">@style/DarkDatePicker</item>
    </style>

    <style name="Theme.NewCarplay" parent="Base.Theme.NewCarplay" />

    <style name="DarkAlertDialog" parent="ThemeOverlay.Material3.Dialog.Alert">
        <item name="android:colorBackground">#1A1A2E</item>
        <item name="colorSurface">#1A1A2E</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">#BBBBBB</item>
        <item name="android:editTextColor">@color/white</item>
        <item name="editTextColor">@color/white</item>
        <item name="colorPrimary">#3E73BF</item>
        <item name="colorAccent">#3E73BF</item>
    </style>

    <style name="DarkDatePicker" parent="ThemeOverlay.Material3.Dialog">
        <item name="android:colorBackground">#1A1A2E</item>
        <item name="colorSurface">#1A1A2E</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">#BBBBBB</item>
        <item name="colorPrimary">#3E73BF</item>
        <item name="colorAccent">#3E73BF</item>
        <item name="android:headerBackground">#2058AF</item>
    </style>

    <style name="DarkSpinnerItem" parent="android:Widget.TextView.SpinnerItem">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/_12ssp</item>
    </style>

    <style name="DarkSpinnerDropdown" parent="android:Widget.ListView.DropDown">
        <item name="android:textColor">@color/white</item>
        <item name="android:background">#1A1A2E</item>
    </style>

    <style name="AppTheme.Ads" parent="Theme.MaterialComponents.Light">
        <item name="android:textSize">@dimen/_10sdp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:layout_gravity">left</item>
        <item name="android:background">@drawable/ads_icon</item>
        <item name="android:layout_marginLeft">@dimen/_1sdp</item>
        <item name="android:layout_marginTop">@dimen/_1sdp</item>
        <item name="android:paddingLeft">@dimen/_5sdp</item>
        <item name="android:paddingRight">@dimen/_5sdp</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">@dimen/_15sdp</item>
        <item name="android:minHeight">@dimen/_15sdp</item>
        <item name="android:text">AD</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="RatingBar" parent="Theme.AppCompat">
        <item name="colorControlNormal">@color/white</item>
        <item name="colorControlActivated">@color/orange</item>
    </style>
    <style name="AdActivityTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowIsTranslucent">false</item>
    </style>
</resources>