<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.NewCarplay" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/primary</item>
        <item name="android:colorBackground">@color/bg_light</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:fitsSystemWindows">true</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="alertDialogTheme">@style/LightAlertDialog</item>
        <item name="android:alertDialogTheme">@style/LightAlertDialog</item>
        <item name="android:datePickerDialogTheme">@style/LightDatePicker</item>
        <item name="android:timePickerDialogTheme">@style/LightDatePicker</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Theme.NewCarplay" parent="Base.Theme.NewCarplay" />

    <style name="LightAlertDialog" parent="ThemeOverlay.Material3.Dialog.Alert">
        <item name="android:colorBackground">@color/white</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:editTextColor">@color/text_primary</item>
        <item name="editTextColor">@color/text_primary</item>
        <item name="colorPrimary">@color/primary</item>
        <item name="colorAccent">@color/primary</item>
    </style>

    <style name="LightDatePicker" parent="ThemeOverlay.Material3.Dialog">
        <item name="android:colorBackground">@color/white</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="colorPrimary">@color/primary</item>
        <item name="colorAccent">@color/primary</item>
        <item name="android:headerBackground">@color/primary</item>
    </style>

    <!-- Keep dark dialog styles for feature screens that still use dark theme -->
    <style name="DarkAlertDialog" parent="ThemeOverlay.Material3.Dialog.Alert">
        <item name="android:colorBackground">#1A1A2E</item>
        <item name="colorSurface">#1A1A2E</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">#BBBBBB</item>
        <item name="android:editTextColor">@color/white</item>
        <item name="editTextColor">@color/white</item>
        <item name="colorPrimary">@color/primary</item>
        <item name="colorAccent">@color/primary</item>
    </style>

    <style name="DarkDatePicker" parent="ThemeOverlay.Material3.Dialog">
        <item name="android:colorBackground">#1A1A2E</item>
        <item name="colorSurface">#1A1A2E</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">#BBBBBB</item>
        <item name="colorPrimary">@color/primary</item>
        <item name="colorAccent">@color/primary</item>
        <item name="android:headerBackground">@color/primary</item>
    </style>

    <style name="DarkSpinnerItem" parent="android:Widget.TextView.SpinnerItem">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/_12ssp</item>
    </style>

    <style name="DarkSpinnerDropdown" parent="android:Widget.ListView.DropDown">
        <item name="android:textColor">@color/white</item>
        <item name="android:background">#1A1A2E</item>
    </style>

    <style name="AppTheme.Ads" parent="Theme.MaterialComponents.Light">
        <item name="android:textSize">@dimen/_10sdp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:layout_gravity">left</item>
        <item name="android:background">@drawable/ads_icon</item>
        <item name="android:layout_marginLeft">@dimen/_1sdp</item>
        <item name="android:layout_marginTop">@dimen/_1sdp</item>
        <item name="android:paddingLeft">@dimen/_5sdp</item>
        <item name="android:paddingRight">@dimen/_5sdp</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">@dimen/_15sdp</item>
        <item name="android:minHeight">@dimen/_15sdp</item>
        <item name="android:text">AD</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="RatingBar" parent="Theme.AppCompat">
        <item name="colorControlNormal">@color/text_hint</item>
        <item name="colorControlActivated">@color/primary</item>
    </style>

    <style name="AdActivityTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:windowIsTranslucent">false</item>
    </style>
</resources>
