<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/stealth_surface" />
        </shape>
    </item>
    <item
        android:gravity="bottom|start"
        android:height="3dp"
        android:width="88dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/stealth_primary" />
        </shape>
    </item>
    <item
        android:bottom="12dp"
        android:gravity="bottom|start"
        android:left="16dp"
        android:right="16dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/stealth_surface_elevated" />
            <corners android:radius="14dp" />
            <stroke
                android:width="1dp"
                android:color="@color/stealth_outline" />
        </shape>
    </item>
</layer-list>
