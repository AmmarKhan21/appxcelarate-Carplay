<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/executive_surface_high" />
            <corners android:radius="16dp" />
            <stroke
                android:width="1dp"
                android:color="@color/executive_primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/executive_surface_elevated" />
            <corners android:radius="16dp" />
            <stroke
                android:width="1dp"
                android:color="@color/executive_outline" />
        </shape>
    </item>
</selector>
