<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:endColor="#142033"
                android:startColor="#0D1828" />
        </shape>
    </item>
    <item
        android:gravity="bottom|start"
        android:height="4dp"
        android:width="96dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/frost_primary" />
        </shape>
    </item>
</layer-list>
