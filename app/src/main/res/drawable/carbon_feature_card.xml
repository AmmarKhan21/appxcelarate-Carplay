<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="2dp"
        android:top="5dp"
        android:right="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/carbon_shadow" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:bottom="5dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/carbon_surface_elevated" />
            <corners android:radius="16dp" />
            <stroke
                android:width="1dp"
                android:color="@color/carbon_outline" />
        </shape>
    </item>
</layer-list>
