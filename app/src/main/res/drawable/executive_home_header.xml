<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/executive_surface" />
        </shape>
    </item>
    <item
        android:gravity="bottom"
        android:height="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/executive_outline" />
        </shape>
    </item>
    <item
        android:gravity="bottom|start"
        android:height="3dp"
        android:width="96dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/executive_primary" />
        </shape>
    </item>
</layer-list>
