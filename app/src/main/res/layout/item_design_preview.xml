<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/preview_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/design_preview_frame"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout
        android:id="@+id/preview_screen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/appBackground"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/preview_header"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <TextView
                android:id="@+id/preview_header_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/executive_home_title"
                android:textColor="?attr/appTextPrimaryColor"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/preview_header_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/design_preview_subtitle"
                android:textColor="?attr/appTextSecondaryColor"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="10dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:background="?attr/featureCardBackground"
                android:gravity="center"
                android:text="@string/design_preview_tile_connect"
                android:textColor="?attr/appTextPrimaryColor"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:background="?attr/featureCardBackground"
                android:gravity="center"
                android:text="@string/design_preview_tile_fuel"
                android:textColor="?attr/appTextPrimaryColor"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="10dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:background="?attr/featureCardBackground"
                android:gravity="center"
                android:text="@string/design_preview_tile_trip"
                android:textColor="?attr/appTextPrimaryColor"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:background="?attr/featureCardBackground"
                android:gravity="center"
                android:text="@string/design_preview_tile_parking"
                android:textColor="?attr/appTextPrimaryColor"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/btn_primary"
            android:paddingStart="14dp"
            android:paddingTop="6dp"
            android:paddingEnd="14dp"
            android:paddingBottom="6dp"
            android:text="@string/design_preview_action"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:layout_marginTop="10dp"
            android:background="?attr/appAdSurfaceColor"
            android:gravity="center"
            android:text="@string/design_preview_ad_slot"
            android:textColor="?attr/appTextSecondaryColor"
            android:textSize="9sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingTop="10dp"
        android:paddingEnd="4dp"
        android:paddingBottom="2dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/preview_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/appTextPrimaryColor"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/preview_description"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:textColor="?attr/appTextSecondaryColor"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/preview_check"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@string/design_selected"
            android:src="@drawable/ic_design_check"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
