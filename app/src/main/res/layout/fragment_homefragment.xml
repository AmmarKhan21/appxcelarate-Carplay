<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/cp_bg"
    tools:context=".Fragments.homefragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/cp_bg">

        <!-- ===== Top bar ===== -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/toolBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/_16sdp"
            android:paddingTop="@dimen/_14sdp"
            android:paddingBottom="@dimen/_8sdp"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/ivNav"
                android:layout_width="@dimen/_38sdp"
                android:layout_height="@dimen/_38sdp"
                android:background="@drawable/cp_icon_circle_dark"
                android:contentDescription="@string/txt_error"
                android:padding="@dimen/_9sdp"
                android:src="@drawable/ic_cp_menu"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/cp_text" />

            <TextView
                android:id="@+id/welcomeLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_10sdp"
                android:fontFamily="@font/manrope_medium"
                android:letterSpacing="0.04"
                android:text="@string/cp_welcome"
                android:textColor="@color/cp_text_muted"
                android:textSize="@dimen/_9ssp"
                app:layout_constraintBottom_toTopOf="@id/homeTitle"
                app:layout_constraintEnd_toStartOf="@id/iv_remove_ads"
                app:layout_constraintStart_toEndOf="@id/ivNav"
                app:layout_constraintTop_toTopOf="@id/ivNav"
                app:layout_constraintVertical_chainStyle="packed" />

            <TextView
                android:id="@+id/homeTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_10sdp"
                android:ellipsize="end"
                android:fontFamily="@font/manrope_extrabold"
                android:maxLines="1"
                android:text="@string/app_name"
                android:textColor="@color/cp_text"
                android:textSize="@dimen/_15ssp"
                app:layout_constraintBottom_toBottomOf="@id/ivNav"
                app:layout_constraintEnd_toStartOf="@id/iv_remove_ads"
                app:layout_constraintStart_toEndOf="@id/ivNav"
                app:layout_constraintTop_toBottomOf="@id/welcomeLabel" />

            <LinearLayout
                android:id="@+id/iv_remove_ads"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_32sdp"
                android:background="@drawable/cp_chip_accent"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/_11sdp"
                app:layout_constraintBottom_toBottomOf="@id/ivNav"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/ivNav">

                <ImageView
                    android:layout_width="@dimen/_13sdp"
                    android:layout_height="@dimen/_13sdp"
                    android:contentDescription="@string/txt_error"
                    android:src="@drawable/ic_cp_shield"
                    app:tint="@color/cp_accent" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_5sdp"
                    android:fontFamily="@font/manrope_bold"
                    android:text="@string/cp_remove_ads"
                    android:textColor="@color/cp_accent"
                    android:textSize="@dimen/_9ssp" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- ===== Scrollable dashboard ===== -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/_14sdp"
            android:paddingBottom="@dimen/_10sdp"
            android:scrollbars="none"
            app:layout_constraintBottom_toTopOf="@id/rmv_ads"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/toolBar">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layoutAnimation="@anim/cp_layout_grid">

                <!-- Hero: Car Connect -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/carplay"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_104sdp"
                    android:background="@drawable/cp_hero"
                    android:clickable="true"
                    android:focusable="true"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:id="@+id/carimg"
                        android:layout_width="@dimen/_50sdp"
                        android:layout_height="@dimen/_50sdp"
                        android:layout_marginStart="@dimen/_16sdp"
                        android:background="@drawable/cp_chipbg_blue"
                        android:contentDescription="@string/txt_error"
                        android:padding="@dimen/_12sdp"
                        android:src="@drawable/ic_cp_car"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="@color/cp_hue_blue" />

                    <TextView
                        android:id="@+id/connectTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_14sdp"
                        android:layout_marginEnd="@dimen/_12sdp"
                        android:fontFamily="@font/manrope_extrabold"
                        android:text="@string/cp_connect_title"
                        android:textColor="@color/cp_text"
                        android:textSize="@dimen/_17ssp"
                        app:layout_constraintBottom_toTopOf="@id/connectSub"
                        app:layout_constraintEnd_toStartOf="@id/connectBtn"
                        app:layout_constraintStart_toEndOf="@id/carimg"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintVertical_chainStyle="packed" />

                    <TextView
                        android:id="@+id/connectSub"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_3sdp"
                        android:fontFamily="@font/manrope_medium"
                        android:text="@string/cp_connect_sub"
                        android:textColor="@color/cp_text_muted"
                        android:textSize="@dimen/_10ssp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="@id/connectTitle"
                        app:layout_constraintStart_toStartOf="@id/connectTitle"
                        app:layout_constraintTop_toBottomOf="@id/connectTitle" />

                    <TextView
                        android:id="@+id/connectBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/_34sdp"
                        android:layout_marginEnd="@dimen/_14sdp"
                        android:background="@drawable/cp_btn_accent"
                        android:fontFamily="@font/manrope_bold"
                        android:gravity="center"
                        android:minWidth="@dimen/_70sdp"
                        android:paddingHorizontal="@dimen/_14sdp"
                        android:text="@string/cp_connect_cta"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_10ssp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Section label -->
                <TextView
                    android:id="@+id/featuresLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_16sdp"
                    android:layout_marginStart="@dimen/_4sdp"
                    android:fontFamily="@font/manrope_bold"
                    android:letterSpacing="0.12"
                    android:text="@string/cp_features"
                    android:textAllCaps="true"
                    android:textColor="@color/cp_text_dim"
                    android:textSize="@dimen/_9ssp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/carplay" />

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/gridCenter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintGuide_percent="0.5" />

                <!-- Speedometer -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/iv_speedometer"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_98sdp"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:layout_marginEnd="@dimen/_5sdp"
                    android:background="@drawable/cp_card"
                    android:clickable="true"
                    android:focusable="true"
                    app:layout_constraintEnd_toStartOf="@id/gridCenter"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/featuresLabel">

                    <ImageView
                        android:layout_width="@dimen/_40sdp"
                        android:layout_height="@dimen/_40sdp"
                        android:layout_marginStart="@dimen/_12sdp"
                        android:layout_marginTop="@dimen/_12sdp"
                        android:background="@drawable/cp_chipbg_sky"
                        android:contentDescription="@string/txt_error"
                        android:padding="@dimen/_9sdp"
                        android:src="@drawable/ic_cp_speed"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="@color/cp_hue_sky" />

                    <ImageView
                        android:layout_width="@dimen/_16sdp"
                        android:layout_height="@dimen/_16sdp"
                        android:layout_marginEnd="@dimen/_10sdp"
                        android:layout_marginTop="@dimen/_12sdp"
                        android:contentDescription="@string/txt_error"
                        android:src="@drawable/ic_cp_chevron"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/speedTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/_12sdp"
                        android:fontFamily="@font/manrope_bold"
                        android:text="@string/cp_speedometer"
                        android:textColor="@color/cp_text"
                        android:textSize="@dimen/_12ssp"
                        app:layout_constraintBottom_toTopOf="@id/speedSub"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView
                        android:id="@+id/speedSub"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/_12sdp"
                        android:layout_marginBottom="@dimen/_12sdp"
                        android:fontFamily="@font/manrope_medium"
                        android:text="@string/cp_speedometer_sub"
                        android:textColor="@color/cp_text_muted"
                        android:textSize="@dimen/_8ssp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Fuel -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/iv_fuel"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_98sdp"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:layout_marginStart="@dimen/_5sdp"
                    android:background="@drawable/cp_card"
                    android:clickable="true"
                    android:focusable="true"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/gridCenter"
                    app:layout_constraintTop_toTopOf="@id/iv_speedometer">

                    <ImageView
                        android:layout_width="@dimen/_40sdp"
                        android:layout_height="@dimen/_40sdp"
                        android:layout_marginStart="@dimen/_12sdp"
                        android:layout_marginTop="@dimen/_12sdp"
                        android:background="@drawable/cp_chipbg_amber"
                        android:contentDescription="@string/txt_error"
                        android:padding="@dimen/_9sdp"
                        android:src="@drawable/ic_cp_fuel"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="@color/cp_hue_amber" />

                    <ImageView
                        android:layout_width="@dimen/_16sdp"
                        android:layout_height="@dimen/_16sdp"
                        android:layout_marginEnd="@dimen/_10sdp"
                        android:layout_marginTop="@dimen/_12sdp"
                        android:contentDescription="@string/txt_error"
                        android:src="@drawable/ic_cp_chevron"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/fuelTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/_12sdp"
                        android:fontFamily="@font/manrope_bold"
                        android:text="@string/cp_fuel"
                        android:textColor="@color/cp_text"
                        android:textSize="@dimen/_12ssp"
                        app:layout_constraintBottom_toTopOf="@id/fuelSub"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView
                        android:id="@+id/fuelSub"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/_12sdp"
                        android:layout_marginBottom="@dimen/_12sdp"
                        android:fontFamily="@font/manrope_medium"
                        android:text="@string/cp_fuel_sub"
                        android:textColor="@color/cp_text_muted"
                        android:textSize="@dimen/_8ssp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Reminders -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/iv_reminders"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_98sdp"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:layout_marginEnd="@dimen/_5sdp"
                    android:background="@drawable/cp_card"
                    android:clickable="true"
                    android:focusable="true"
                    app:layout_constraintEnd_toStartOf="@id/gridCenter"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/iv_speedometer">

                    <ImageView
                        android:layout_width="@dimen/_40sdp"
                        android:layout_height="@dimen/_40sdp"
                        android:layout_marginStart="@dimen/_12sdp"
                        android:layout_marginTop="@dimen/_12sdp"
                        android:background="@drawable/cp_chipbg_violet"
                        android:contentDescription="@string/txt_error"
                        android:padding="@dimen/_9sdp"
                        android:src="@drawable/ic_cp_bell"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="@color/cp_hue_violet" />

                    <ImageView
                        android:layout_width="@dimen/_16sdp"
                        android:layout_height="@dimen/_16sdp"
                        android:layout_marginEnd="@dimen/_10sdp"
                        android:layout_marginTop="@dimen/_12sdp"
                        android:contentDescription="@string/txt_error"
                        android:src="@drawable/ic_cp_chevron"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/remindTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/_12sdp"
                        android:fontFamily="@font/manrope_bold"
                        android:text="@string/cp_reminders"
                        android:textColor="@color/cp_text"
                        android:textSize="@dimen/_12ssp"
                        app:layout_constraintBottom_toTopOf="@id/remindSub"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView
                        android:id="@+id/remindSub"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/_12sdp"
                        android:layout_marginBottom="@dimen/_12sdp"
                        android:fontFamily="@font/manrope_medium"
                        android:text="@string/cp_reminders_sub"
                        android:textColor="@color/cp_text_muted"
                        android:textSize="@dimen/_8ssp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Documents -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/iv_documents"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_98sdp"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:layout_marginStart="@dimen/_5sdp"
                    android:background="@drawable/cp_card"
                    android:clickable="true"
                    android:focusable="true"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/gridCenter"
                    app:layout_constraintTop_toTopOf="@id/iv_reminders">

                    <ImageView
                        android:id="@+id/docimg"
                        android:layout_width="@dimen/_40sdp"
                        android:layout_height="@dimen/_40sdp"
                        android:layout_marginStart="@dimen/_12sdp"
                        android:layout_marginTop="@dimen/_12sdp"
                        android:background="@drawable/cp_chipbg_green"
                        android:contentDescription="@string/txt_error"
                        android:padding="@dimen/_9sdp"
                        android:src="@drawable/ic_cp_doc"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="@color/cp_hue_green" />

                    <ImageView
                        android:layout_width="@dimen/_16sdp"
                        android:layout_height="@dimen/_16sdp"
                        android:layout_marginEnd="@dimen/_10sdp"
                        android:layout_marginTop="@dimen/_12sdp"
                        android:contentDescription="@string/txt_error"
                        android:src="@drawable/ic_cp_chevron"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/docTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/_12sdp"
                        android:fontFamily="@font/manrope_bold"
                        android:text="@string/document"
                        android:textColor="@color/cp_text"
                        android:textSize="@dimen/_12ssp"
                        app:layout_constraintBottom_toTopOf="@id/docSub"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView
                        android:id="@+id/docSub"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/_12sdp"
                        android:layout_marginBottom="@dimen/_12sdp"
                        android:fontFamily="@font/manrope_medium"
                        android:text="@string/cp_documents_sub"
                        android:textColor="@color/cp_text_muted"
                        android:textSize="@dimen/_8ssp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Expense -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/iv_mnt_expense"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_98sdp"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:layout_marginEnd="@dimen/_5sdp"
                    android:background="@drawable/cp_card"
                    android:clickable="true"
                    android:focusable="true"
                    app:layout_constraintEnd_toStartOf="@id/gridCenter"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/iv_reminders">

                    <ImageView
                        android:id="@+id/expenseimg"
                        android:layout_width="@dimen/_40sdp"
                        android:layout_height="@dimen/_40sdp"
                        android:layout_marginStart="@dimen/_12sdp"
                        android:layout_marginTop="@dimen/_12sdp"
                        android:background="@drawable/cp_chipbg_rose"
                        android:contentDescription="@string/txt_error"
                        android:padding="@dimen/_9sdp"
                        android:src="@drawable/ic_cp_wallet"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="@color/cp_hue_rose" />

                    <ImageView
                        android:layout_width="@dimen/_16sdp"
                        android:layout_height="@dimen/_16sdp"
                        android:layout_marginEnd="@dimen/_10sdp"
                        android:layout_marginTop="@dimen/_12sdp"
                        android:contentDescription="@string/txt_error"
                        android:src="@drawable/ic_cp_chevron"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/expenseTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/_12sdp"
                        android:fontFamily="@font/manrope_bold"
                        android:text="@string/cp_expense"
                        android:textColor="@color/cp_text"
                        android:textSize="@dimen/_12ssp"
                        app:layout_constraintBottom_toTopOf="@id/expenseSub"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView
                        android:id="@+id/expenseSub"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/_12sdp"
                        android:layout_marginBottom="@dimen/_12sdp"
                        android:fontFamily="@font/manrope_medium"
                        android:text="@string/cp_expense_sub"
                        android:textColor="@color/cp_text_muted"
                        android:textSize="@dimen/_8ssp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Car Parking -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/iv_carparking"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_98sdp"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:layout_marginStart="@dimen/_5sdp"
                    android:background="@drawable/cp_card"
                    android:clickable="true"
                    android:focusable="true"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/gridCenter"
                    app:layout_constraintTop_toTopOf="@id/iv_mnt_expense">

                    <ImageView
                        android:id="@+id/parkimg"
                        android:layout_width="@dimen/_40sdp"
                        android:layout_height="@dimen/_40sdp"
                        android:layout_marginStart="@dimen/_12sdp"
                        android:layout_marginTop="@dimen/_12sdp"
                        android:background="@drawable/cp_chipbg_teal"
                        android:contentDescription="@string/txt_error"
                        android:padding="@dimen/_9sdp"
                        android:src="@drawable/ic_cp_parking"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="@color/cp_hue_teal" />

                    <ImageView
                        android:layout_width="@dimen/_16sdp"
                        android:layout_height="@dimen/_16sdp"
                        android:layout_marginEnd="@dimen/_10sdp"
                        android:layout_marginTop="@dimen/_12sdp"
                        android:contentDescription="@string/txt_error"
                        android:src="@drawable/ic_cp_chevron"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/parkTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/_12sdp"
                        android:fontFamily="@font/manrope_bold"
                        android:text="@string/cp_parking"
                        android:textColor="@color/cp_text"
                        android:textSize="@dimen/_12ssp"
                        app:layout_constraintBottom_toTopOf="@id/parkSub"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView
                        android:id="@+id/parkSub"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/_12sdp"
                        android:layout_marginBottom="@dimen/_12sdp"
                        android:fontFamily="@font/manrope_medium"
                        android:text="@string/cp_parking_sub"
                        android:textColor="@color/cp_text_muted"
                        android:textSize="@dimen/_8ssp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Weather (wide) -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/iv_weather"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_66sdp"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:background="@drawable/cp_card"
                    android:clickable="true"
                    android:focusable="true"
                    app:layout_constraintTop_toBottomOf="@id/iv_mnt_expense">

                    <ImageView
                        android:id="@+id/weatherimg"
                        android:layout_width="@dimen/_42sdp"
                        android:layout_height="@dimen/_42sdp"
                        android:layout_marginStart="@dimen/_14sdp"
                        android:background="@drawable/cp_chipbg_blue"
                        android:contentDescription="@string/txt_error"
                        android:padding="@dimen/_10sdp"
                        android:src="@drawable/ic_cp_weather"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="@color/cp_hue_blue" />

                    <TextView
                        android:id="@+id/weatherTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_14sdp"
                        android:fontFamily="@font/manrope_bold"
                        android:text="@string/cp_weather"
                        android:textColor="@color/cp_text"
                        android:textSize="@dimen/_13ssp"
                        app:layout_constraintBottom_toTopOf="@id/weatherSub"
                        app:layout_constraintEnd_toStartOf="@id/weatherChevron"
                        app:layout_constraintStart_toEndOf="@id/weatherimg"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintVertical_chainStyle="packed" />

                    <TextView
                        android:id="@+id/weatherSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/manrope_medium"
                        android:text="@string/cp_weather_sub"
                        android:textColor="@color/cp_text_muted"
                        android:textSize="@dimen/_9ssp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="@id/weatherTitle"
                        app:layout_constraintTop_toBottomOf="@id/weatherTitle" />

                    <ImageView
                        android:id="@+id/weatherChevron"
                        android:layout_width="@dimen/_16sdp"
                        android:layout_height="@dimen/_16sdp"
                        android:layout_marginEnd="@dimen/_12sdp"
                        android:contentDescription="@string/txt_error"
                        android:src="@drawable/ic_cp_chevron"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- ===== Remove ads banner ===== -->
        <LinearLayout
            android:id="@+id/rmv_ads"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_54sdp"
            android:layout_marginHorizontal="@dimen/_14sdp"
            android:layout_marginBottom="@dimen/_8sdp"
            android:background="@drawable/cp_remove_ads"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/_14sdp"
            app:layout_constraintBottom_toTopOf="@id/native_ad"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <ImageView
                android:layout_width="@dimen/_32sdp"
                android:layout_height="@dimen/_32sdp"
                android:background="@drawable/cp_chipbg_blue"
                android:contentDescription="@string/txt_error"
                android:padding="@dimen/_7sdp"
                android:src="@drawable/ic_cp_shield"
                app:tint="@color/cp_accent" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_10sdp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/manrope_bold"
                    android:text="@string/cp_go_adfree"
                    android:textColor="@color/cp_text"
                    android:textSize="@dimen/_12ssp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/manrope_medium"
                    android:text="@string/cp_go_adfree_sub"
                    android:textColor="@color/cp_text_muted"
                    android:textSize="@dimen/_9ssp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_32sdp"
                android:background="@drawable/cp_btn_accent"
                android:fontFamily="@font/manrope_bold"
                android:gravity="center"
                android:paddingHorizontal="@dimen/_14sdp"
                android:text="@string/cp_upgrade"
                android:textColor="@color/white"
                android:textSize="@dimen/_10ssp" />
        </LinearLayout>

        <!-- ===== Native ad ===== -->
        <androidx.cardview.widget.CardView
            android:id="@+id/native_ad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_14sdp"
            android:layout_marginBottom="@dimen/_8sdp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/cp_surface"
            app:cardCornerRadius="@dimen/_16sdp"
            app:cardElevation="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ===== Drawer ===== -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigation"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:itemBackground="@android:color/transparent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/cp_bg"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/_150sdp"
                android:background="@drawable/cp_header"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="@dimen/_60sdp"
                    android:layout_height="@dimen/_60sdp"
                    android:background="@drawable/cp_chipbg_blue"
                    android:contentDescription="@string/txt_error"
                    android:padding="@dimen/_14sdp"
                    android:src="@drawable/ic_cp_car"
                    app:tint="@color/cp_accent" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:fontFamily="@font/manrope_extrabold"
                    android:text="@string/app_name"
                    android:textColor="@color/cp_text"
                    android:textSize="@dimen/_14ssp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/manrope_medium"
                    android:text="@string/cp_tagline"
                    android:textColor="@color/cp_text_muted"
                    android:textSize="@dimen/_9ssp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_14sdp"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/iv_ratus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/_12sdp"
                    android:layout_marginVertical="@dimen/_4sdp"
                    android:background="@drawable/cp_card_alt"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/_12sdp"
                    tools:ignore="UseCompoundDrawables">

                    <ImageView
                        android:layout_width="@dimen/_22sdp"
                        android:layout_height="@dimen/_22sdp"
                        android:contentDescription="@string/txt_error"
                        android:src="@drawable/rate_us" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_12sdp"
                        android:fontFamily="@font/manrope_medium"
                        android:text="@string/txt_ratus"
                        android:textColor="@color/cp_text"
                        android:textSize="@dimen/_12ssp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/iv_share"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/_12sdp"
                    android:layout_marginVertical="@dimen/_4sdp"
                    android:background="@drawable/cp_card_alt"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/_12sdp"
                    tools:ignore="UseCompoundDrawables">

                    <ImageView
                        android:layout_width="@dimen/_22sdp"
                        android:layout_height="@dimen/_22sdp"
                        android:contentDescription="@string/txt_error"
                        android:src="@drawable/share" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_12sdp"
                        android:fontFamily="@font/manrope_medium"
                        android:text="@string/txt_share_app"
                        android:textColor="@color/cp_text"
                        android:textSize="@dimen/_12ssp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/iv_privacy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/_12sdp"
                    android:layout_marginVertical="@dimen/_4sdp"
                    android:background="@drawable/cp_card_alt"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/_12sdp"
                    tools:ignore="UseCompoundDrawables">

                    <ImageView
                        android:layout_width="@dimen/_22sdp"
                        android:layout_height="@dimen/_22sdp"
                        android:contentDescription="@string/txt_error"
                        android:src="@drawable/privacy" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_12sdp"
                        android:fontFamily="@font/manrope_medium"
                        android:text="@string/txt_privacy"
                        android:textColor="@color/cp_text"
                        android:textSize="@dimen/_12ssp" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.navigation.NavigationView>

</androidx.drawerlayout.widget.DrawerLayout>
