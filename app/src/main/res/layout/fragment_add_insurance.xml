<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/app_bg"
    tools:context=".Fragments.AddInsuranceFragment">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/app_bg"
        android:contentDescription="@string/txt_error"
        android:scaleType="fitXY"
        tools:layout_editor_absoluteX="0dp"
        tools:layout_editor_absoluteY="0dp" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/toolBar"
        android:layout_width="match_parent"
        android:layout_height="?actionBarSize"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ic_back"
            android:layout_width="@dimen/_50sdp"
            android:layout_height="@dimen/_50sdp"
            android:contentDescription="@string/txt_error"
            android:padding="@dimen/_15sdp"
            android:src="@drawable/back_errow"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add Insurance"
            android:textColor="@color/white"
            android:textSize="@dimen/_20sdp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/ic_back"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolBar">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/_7sdp"
            android:paddingEnd="@dimen/_7sdp"
            android:paddingBottom="@dimen/_10sdp">

            <TextView
                android:id="@+id/labelPolicyNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:text="Policy Number"
                android:textColor="@color/white"
                android:textSize="@dimen/_13ssp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <EditText
                android:id="@+id/et_policy_number"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_45sdp"
                android:layout_marginTop="@dimen/_3sdp"
                android:background="@drawable/roundeded_bg1"
                android:hint="Enter policy number"
                android:padding="@dimen/_15sdp"
                android:textColor="@color/white"
                android:textColorHint="#AAAAAA"
                android:textSize="@dimen/_13ssp"
                app:layout_constraintTop_toBottomOf="@id/labelPolicyNumber" />

            <TextView
                android:id="@+id/labelProvider"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:text="Provider"
                android:textColor="@color/white"
                android:textSize="@dimen/_13ssp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/et_policy_number" />

            <EditText
                android:id="@+id/et_provider"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_45sdp"
                android:layout_marginTop="@dimen/_3sdp"
                android:background="@drawable/roundeded_bg1"
                android:hint="Enter provider name"
                android:padding="@dimen/_15sdp"
                android:textColor="@color/white"
                android:textColorHint="#AAAAAA"
                android:textSize="@dimen/_13ssp"
                app:layout_constraintTop_toBottomOf="@id/labelProvider" />

            <TextView
                android:id="@+id/labelType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:text="Type"
                android:textColor="@color/white"
                android:textSize="@dimen/_13ssp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/et_provider" />

            <EditText
                android:id="@+id/et_type"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_45sdp"
                android:layout_marginTop="@dimen/_3sdp"
                android:background="@drawable/roundeded_bg1"
                android:hint="Comprehensive/Third-Party"
                android:padding="@dimen/_15sdp"
                android:textColor="@color/white"
                android:textColorHint="#AAAAAA"
                android:textSize="@dimen/_13ssp"
                app:layout_constraintTop_toBottomOf="@id/labelType" />

            <TextView
                android:id="@+id/labelPremium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:text="Premium"
                android:textColor="@color/white"
                android:textSize="@dimen/_13ssp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/et_type" />

            <EditText
                android:id="@+id/et_premium"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_45sdp"
                android:layout_marginTop="@dimen/_3sdp"
                android:background="@drawable/roundeded_bg1"
                android:hint="Enter premium amount"
                android:inputType="numberDecimal"
                android:padding="@dimen/_15sdp"
                android:textColor="@color/white"
                android:textColorHint="#AAAAAA"
                android:textSize="@dimen/_13ssp"
                app:layout_constraintTop_toBottomOf="@id/labelPremium" />

            <TextView
                android:id="@+id/labelStartDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:text="Start Date"
                android:textColor="@color/white"
                android:textSize="@dimen/_13ssp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/et_premium" />

            <TextView
                android:id="@+id/tv_start_date"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_45sdp"
                android:layout_marginTop="@dimen/_3sdp"
                android:background="@drawable/roundeded_bg1"
                android:gravity="center_vertical"
                android:hint="Select start date"
                android:padding="@dimen/_15sdp"
                android:textColor="@color/white"
                android:textColorHint="#AAAAAA"
                android:textSize="@dimen/_13ssp"
                app:layout_constraintTop_toBottomOf="@id/labelStartDate" />

            <TextView
                android:id="@+id/labelEndDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:text="End Date"
                android:textColor="@color/white"
                android:textSize="@dimen/_13ssp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_start_date" />

            <TextView
                android:id="@+id/tv_end_date"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_45sdp"
                android:layout_marginTop="@dimen/_3sdp"
                android:background="@drawable/roundeded_bg1"
                android:gravity="center_vertical"
                android:hint="Select end date"
                android:padding="@dimen/_15sdp"
                android:textColor="@color/white"
                android:textColorHint="#AAAAAA"
                android:textSize="@dimen/_13ssp"
                app:layout_constraintTop_toBottomOf="@id/labelEndDate" />

            <TextView
                android:id="@+id/labelAgentName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:text="Agent Name"
                android:textColor="@color/white"
                android:textSize="@dimen/_13ssp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_end_date" />

            <EditText
                android:id="@+id/et_agent_name"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_45sdp"
                android:layout_marginTop="@dimen/_3sdp"
                android:background="@drawable/roundeded_bg1"
                android:hint="Enter agent name"
                android:padding="@dimen/_15sdp"
                android:textColor="@color/white"
                android:textColorHint="#AAAAAA"
                android:textSize="@dimen/_13ssp"
                app:layout_constraintTop_toBottomOf="@id/labelAgentName" />

            <TextView
                android:id="@+id/labelAgentPhone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:text="Agent Phone"
                android:textColor="@color/white"
                android:textSize="@dimen/_13ssp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/et_agent_name" />

            <EditText
                android:id="@+id/et_agent_phone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_45sdp"
                android:layout_marginTop="@dimen/_3sdp"
                android:background="@drawable/roundeded_bg1"
                android:hint="Enter agent phone"
                android:inputType="phone"
                android:padding="@dimen/_15sdp"
                android:textColor="@color/white"
                android:textColorHint="#AAAAAA"
                android:textSize="@dimen/_13ssp"
                app:layout_constraintTop_toBottomOf="@id/labelAgentPhone" />

            <TextView
                android:id="@+id/labelNotes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:text="Notes"
                android:textColor="@color/white"
                android:textSize="@dimen/_13ssp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/et_agent_phone" />

            <EditText
                android:id="@+id/et_notes"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_80sdp"
                android:layout_marginTop="@dimen/_3sdp"
                android:background="@drawable/roundeded_bg1"
                android:gravity="top|start"
                android:hint="Enter notes (optional)"
                android:inputType="textMultiLine"
                android:padding="@dimen/_15sdp"
                android:textColor="@color/white"
                android:textColorHint="#AAAAAA"
                android:textSize="@dimen/_13ssp"
                app:layout_constraintTop_toBottomOf="@id/labelNotes" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_attach"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_45sdp"
                android:layout_marginTop="@dimen/_10sdp"
                android:backgroundTint="#727A99"
                android:text="Attach Document"
                android:textColor="@color/white"
                android:textSize="@dimen/_13ssp"
                app:cornerRadius="@dimen/_10sdp"
                app:layout_constraintTop_toBottomOf="@id/et_notes" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_45sdp"
                android:layout_marginTop="@dimen/_15sdp"
                android:backgroundTint="@color/orange"
                android:text="Save Policy"
                android:textColor="@color/white"
                android:textSize="@dimen/_14ssp"
                android:textStyle="bold"
                app:cornerRadius="@dimen/_10sdp"
                app:layout_constraintTop_toBottomOf="@id/btn_attach" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
