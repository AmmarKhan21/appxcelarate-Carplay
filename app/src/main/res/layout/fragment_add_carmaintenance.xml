<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/app_bg"
    tools:context=".Fragments.AddCarmaintenance">


    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/app_bg"
        android:contentDescription="@string/txt_error"
        android:scaleType="fitXY"
        tools:layout_editor_absoluteX="0dp"
        tools:layout_editor_absoluteY="0dp" />

    <ImageView
        android:id="@+id/top"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_110sdp"
        android:background="@drawable/maintenencetop"
        android:contentDescription="@string/txt_error"
        android:scaleType="fitXY"
        tools:ignore="MissingConstraints"
        tools:layout_editor_absoluteX="0dp"
        tools:layout_editor_absoluteY="0dp" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/toolBar"
        android:layout_width="match_parent"
        android:layout_height="?actionBarSize"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top">

        <ImageView
            android:id="@+id/ic_back"
            android:layout_width="@dimen/_50sdp"
            android:layout_height="@dimen/_50sdp"
            android:contentDescription="@string/txt_error"
            android:src="@drawable/back_errow"
            android:padding="@dimen/_15sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/addservices"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold"
            android:visibility="visible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/ic_back"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/nametitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/servicename"
        android:textColor="@color/white"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginTop="@dimen/_10sdp"
        android:layout_marginStart="@dimen/_2sdp"
        android:visibility="visible"
        app:layout_constraintStart_toStartOf="@id/s_name"
        app:layout_constraintTop_toBottomOf="@id/toolBar"/>

    <EditText
        android:id="@+id/s_name"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_45sdp"
        android:hint="Name"
        android:padding="@dimen/_15sdp"
        android:textColor="@color/white"
        android:textColorHint="@color/white"
        android:layout_marginEnd="@dimen/_7sdp"
        android:layout_marginStart="@dimen/_7sdp"
        app:layout_constraintTop_toBottomOf="@+id/nametitle"
        android:textSize="@dimen/_15sdp"
        android:background="@drawable/roundeded_bg1"/>
    <TextView
        android:id="@+id/costtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/costtitle"
        android:textColor="@color/white"
        android:textSize="22sp"
        android:layout_marginTop="@dimen/_10sdp"
        android:layout_marginStart="@dimen/_2sdp"
        android:visibility="visible"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@id/cost"
        app:layout_constraintTop_toBottomOf="@id/s_name"/>
    <EditText
        android:id="@+id/cost"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_45sdp"
        android:hint="Cost"
        android:padding="@dimen/_15sdp"
        android:inputType="numberDecimal"
        android:layout_marginTop="@dimen/_3sdp"
        android:textColorHint="@color/white"
        android:layout_marginEnd="@dimen/_7sdp"
        android:layout_marginStart="@dimen/_7sdp"
        app:layout_constraintTop_toBottomOf="@+id/costtitle"
        android:textSize="@dimen/_15sdp"
        android:background="@drawable/roundeded_bg1"/>

    <ImageView
        android:id="@+id/save"
        android:layout_width="@dimen/_100sdp"
        android:layout_height="@dimen/_40sdp"
        android:src="@drawable/save_btn"
        android:layout_marginTop="@dimen/_10sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cost"
        android:layout_marginEnd="@dimen/_7sdp"
        />

    <androidx.cardview.widget.CardView
        android:id="@+id/native_ad"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="visible"
        app:cardBackgroundColor="@color/bg_dark"
        app:cardCornerRadius="0dp"
        app:cardElevation="0dp"
        android:layout_marginBottom="@dimen/_5sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/_100sdp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_centerInParent="true"
                android:gravity="center"
                android:text="advertisement"
                android:textColor="@color/black"
                android:textSize="20sp" />

            <com.google.android.gms.ads.nativead.NativeAdView
                android:id="@+id/admobnative"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>





</androidx.constraintlayout.widget.ConstraintLayout>